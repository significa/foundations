---
import { ClientRouter } from "astro:transitions";
import { STORAGE_KEY as DS_CONFIG_STORAGE_KEY } from "#/components/ds-config/storage.ts";
import Posthog from "#/components/posthog.astro";
import { Toaster } from "#/foundations/ui/toaster/toaster.tsx";
import { THEME_STORAGE_KEY } from "#/lib/theme.ts";

import "#/styles/global.css";

type Props = {
  meta?: {
    title?: string;
    description?: string;
  };
};

const { meta } = Astro.props;

const title = meta?.title || "Foundations by Significa - A base config for digital products.";
const description =
  meta?.description ||
  "Explore Significa Foundations: our design and development principles, methodologies, and tools that ensure every digital product we create is purposeful, accessible, and beautifully built.";
---

<html lang="en" transition:animate="none">
  <head>
    {/* Apply the stored or system theme synchronously before paint to avoid a flash of light theme on dark-mode sessions. */}
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      (() => {
        try {
          const stored = localStorage.getItem(storageKey);
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          if (theme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch {}
      })();
    </script>

    {/* Apply the stored DSConfig variables before paint, so there's no flash of default tokens before React hydrates. Iframe previews also follow the page's changes live. */}
    <script is:inline define:vars={{ storageKey: DS_CONFIG_STORAGE_KEY }}>
      (() => {
        const root = document.documentElement;
        let applied = [];
        const apply = (raw) => {
          for (const name of applied) root.style.removeProperty(name);
          applied = [];
          const cfg = (() => {
            try {
              return JSON.parse(raw || "null");
            } catch {
              return null;
            }
          })();
          if (!cfg || typeof cfg !== "object") return;
          const vars = cfg.vars || {};
          for (const name in vars) {
            root.style.setProperty(name, vars[name]);
            applied.push(name);
          }
          const fonts = cfg.fonts || {};
          for (const slot in fonts) {
            const family = fonts[slot]?.family;
            if (!family) continue;
            const href =
              "https://fonts.googleapis.com/css2?family=" +
              encodeURIComponent(family).replace(/%20/g, "+") +
              ":wght@400;500;600;700&display=swap";
            if (!document.querySelector(`link[rel="stylesheet"][href="${href}"]`)) {
              const l = document.createElement("link");
              l.rel = "stylesheet";
              l.href = href;
              document.head.appendChild(l);
            }
          }
        };
        try {
          apply(localStorage.getItem(storageKey));
        } catch {}
        // Only iframes: a top-level tab's React state would fight a config written by another tab
        if (window.self !== window.top) {
          window.addEventListener("storage", (event) => {
            if (event.key === storageKey) apply(event.newValue);
          });
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image" content="/opengraph-image.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:type" content="image/png" />
    <meta name="twitter:image:width" content="2400" />
    <meta name="twitter:image:height" content="1260" />
    <meta name="twitter:image" content="/opengraph-image.png" />

    <ClientRouter fallback="none" />
  </head>
  <body>
    <slot />

    <Toaster client:load />
    {import.meta.env.PROD && <Posthog />}
  </body>
</html>
