---
import { getEntry } from "astro:content";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
import { Button, buttonStyle } from "#/foundations/ui/button/button.tsx";
import type { PreviewLayout, PreviewMode } from "#/lib/preview.ts";
import ComponentPreview from "./component-preview.astro";
import SourceCode from "./source-code.astro";

type Props = {
  slug: string;
  layout?: PreviewLayout;
  mode?: PreviewMode;
};

const { slug } = Astro.props;

const entry = await getEntry("previews", slug);

if (!entry) {
  throw new Error(`No preview found for slug: ${slug}`);
}

const layout = Astro.props.layout ?? entry.data.meta?.layout;
const mode = Astro.props.mode ?? entry.data.meta?.mode;
// The iframe page is static: a layout set on the tag rides along in the query.
const previewPath =
  layout === entry.data.meta?.layout
    ? `/preview/${entry.id}`
    : `/preview/${entry.id}?layout=${layout}`;
---

<div
  class="group/preview relative my-4 h-85 md:h-100"
  data-id="preview"
  data-view="preview"
  data-escape-markdown
>
  <div class="size-full overflow-hidden rounded-lg border group-data-[view=source]/preview:hidden">
    {mode === "iframe" ? (
      <iframe src={previewPath} title={`${entry.id} preview`} class="size-full" />
    ) : (
      <ComponentPreview file={entry.data.file} layout={layout} />
    )}
  </div>
  <SourceCode file={entry.data.file} class="h-full group-data-[view=preview]/preview:hidden" />

  <div class="absolute right-0 bottom-0 z-20 flex items-center gap-2 p-3">
    <Button
      size="sm"
      variant="outline"
      data-id="preview-toggle"
      className="after:content-['source'] group-data-[view=source]/preview:after:content-['preview']"
    >
      View
    </Button>
    <a
      href={previewPath}
      target="_blank"
      class={buttonStyle({
        size: "sm",
        variant: "outline",
        square: true,
        className: "no-underline cursor-pointer",
      })}
    >
      <ArrowSquareOutIcon />
    </a>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggles = [...document.querySelectorAll("[data-id=preview-toggle]")];

    for (const toggle of toggles) {
      toggle?.addEventListener("click", () => {
        const container = toggle.closest("[data-id=preview]");
        if (!container) return;

        const currentView = container.getAttribute("data-view");
        const newView = currentView === "preview" ? "source" : "preview";

        container.setAttribute("data-view", newView);
      });
    }
  });
</script>
