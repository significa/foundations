---
import { getCollection, render } from "astro:content";
import { ArrowSquareOutIcon, CalendarIcon, PackageIcon, PencilIcon } from "@phosphor-icons/react";
import { format } from "date-fns";
import CodeBlock from "#/components/code-block.astro";
import Preview from "#/components/preview.astro";
import PropsTable from "#/components/props-table.astro";
import SourceCode from "#/components/source-code.astro";
import { TableOfContents } from "#/components/table-of-contents.tsx";
import { Badge } from "#/foundations/ui/badge/badge.tsx";
import PageLayout from "#/layouts/page.astro";
import Shell from "#/layouts/shell.astro";
import { GITHUB_REPO_URL } from "#/lib/constants.ts";
import { getPageLastModifiedTime } from "#/lib/utils/content.ts";

export async function getStaticPaths() {
  const pages = await getCollection("pages");

  return pages.map((page, index, arr) => ({
    params: { path: page.id },
    props: {
      page,
      previousPage: arr[index - 1],
      nextPage: arr[index + 1],
    },
  }));
}

const { page, previousPage, nextPage } = Astro.props;
const { Content, headings } = await render(page);

const lastModified = await getPageLastModifiedTime(page);
---

<Shell meta={{ title: page.data.title, description: page.data.description }}>
  <PageLayout data-pagefind-meta={`folder:${page.data.folder || "Other"}`}>
    <fragment slot="nav">
      <h3 class="mb-3 font-medium text-foreground-secondary">On this page</h3>
      <TableOfContents
        client:load
        headings={headings.filter(({ depth }) => depth <= (page.data.maxTocDepth ?? 3))}
      />
      <hr class="my-6" />
      <div class="text-xs text-foreground-secondary">
        <a
          class="mb-2 inline-flex items-center gap-1 font-medium transition hover:text-foreground"
          href={`${GITHUB_REPO_URL}/edit/main/${page.filePath}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <PencilIcon />
          Edit this page
        </a>
        {lastModified && (
          <p class="flex items-center gap-1 text-xs text-foreground-secondary">
            <CalendarIcon />
            Edited {format(lastModified, "PPP")}
          </p>
        )}
      </div>
    </fragment>

    <section>
      <div class="mb-8">
        <h1 class="font-heading text-3xl font-bold tracking-tight">{page.data.title}</h1>
        <p class="mt-2 text-pretty text-foreground-secondary">{page.data.description}</p>
      </div>
    </section>

    <section data-markdown class="pb-40">
      {page.data.preview && <Preview slug={page.data.preview.id} />}
      {page.data.dependencies && page.data.dependencies.length > 0 && (
        <>
          <h2 id="dependencies">Dependencies</h2>
          <div class="flex flex-wrap gap-2">
            {page.data.dependencies.map(({ name, href }) => {
              const type = href.startsWith("/") ? "internal" : "external";

              return (
                <a href={href} target={type === "external" ? "_blank" : undefined}>
                  <Badge key={name} variant={type === "external" ? "neutral" : "info"}>
                    <Badge.Icon>
                      <PackageIcon />
                    </Badge.Icon>
                    <span>{name}</span>
                    {type === "external" && (
                      <Badge.Icon>
                        <ArrowSquareOutIcon className="text-foreground-secondary" />
                      </Badge.Icon>
                    )}
                  </Badge>
                </a>
              );
            })}
          </div>
        </>
      )}

      {page.data.files && page.data.files.length > 0 && (
        <>
          <h2 id="source-code">Source Code</h2>
          {page.data.files.map((file) => (
            <SourceCode class="mt-6" file={file} collapsible />
          ))}
        </>
      )}

      <Content
        components={{
          pre: CodeBlock,
          SourceCode,
          Preview,
          PropsTable,
        }}
      />
    </section>

    {(previousPage || nextPage) && (
      <section class="flex flex-col gap-4 sm:flex-row">
        {[previousPage, nextPage].map((page, index) => {
          if (!page) return null;

          return (
            <a
              class:list={[
                "flex-1 rounded-lg border border-border p-4 transition outline-none hover:bg-foreground/3 focus-visible:bg-foreground/3",
                index > 0 && "text-right",
              ]}
              href={`/${page.id}`}
            >
              <p class="mb-1 text-xs text-foreground-secondary">{["Previous", "Next"][index]}</p>
              <p class="text-sm font-medium">{page.data.title}</p>
            </a>
          );
        })}
      </section>
    )}
  </PageLayout>
</Shell>
