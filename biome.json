{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["@significa/ts-standards/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "tailwind": {
    "stylesheet": "./src/styles/global.css",
    "attributes": ["class", "className", "class:list"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["..", "../**", "./../**"],
                "message": "Use the #/ alias for cross-directory imports (e.g. #/foundations/ui/button/button.tsx)."
              }
            ]
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "always"
    }
  },
  "css": {
    "formatter": {
      "lineWidth": 128
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "error",
            "noUnusedVariables": "error"
          }
        }
      }
    },
    {
      "includes": ["src/components/posthog.astro"],
      "linter": { "enabled": false }
    }
  ]
}
