{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["@significa/ts-standards/biome"],
  "files": {
    "includes": ["!!**/*.astro"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "tailwind": {
    "stylesheet": "./src/styles/global.css"
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["..", "../**", "./../**"],
                "message": "Use the #/ alias for cross-directory imports (e.g. #/foundations/ui/button/button.tsx)."
              }
            ]
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "css": {
    "formatter": {
      "lineWidth": 128
    }
  }
}
