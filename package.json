{
  "name": "foundations",
  "type": "module",
  "version": "0.0.1-development",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:pagefind": "pnpm build && node ./scripts/pagefind.mjs --dev && pnpm dev",
    "build": "astro build",
    "postbuild": "node scripts/pagefind.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "types:check": "astro sync && tsc -noEmit",
    "format": "biome format --write .",
    "lint": "biome lint --write --unsafe .",
    "check:deps": "node scripts/check-page-deps.mjs",
    "knip": "knip",
    "check": "biome ci && pnpm types:check && pnpm check:deps && pnpm knip"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.5",
    "@floating-ui/react": "^0.27.20",
    "@hookform/resolvers": "^7.0.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.8",
    "chroma-js": "^3.3.0",
    "cva": "1.0.0-beta.4",
    "date-fns": "^4.4.0",
    "motion": "^14.12.0",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@significa/ts-standards": "0.2.3",
    "knip": "^6.44.2",
    "typescript": "6.0.3"
  }
}
