{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["@significa/ts-standards/biome"],
  "files": {
    "includes": ["!!**/*.astro"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "tailwind": {
    "stylesheet": "./src/styles/global.css"
  },
  "linter": {
    "rules": {
      "a11y": {
        // Temporary: nested <label><Checkbox /></label> is valid; drop once ts-standards settles noLabelWithoutControl.
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox"] }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "css": {
    "formatter": {
      "lineWidth": 128
    }
  }
}
